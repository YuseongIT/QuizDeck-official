# Frontend production environment
# Point the app to the public API base served by Nginx under the same domain
REACT_APP_API_BASE=https://your-domain.com

# Optional: if you serve images/media directly from S3 or a CDN, set this so UI rewrites storage paths
# REACT_APP_ASSET_BASE=https://your-cdn-or-s3-bucket.s3.amazonaws.com
