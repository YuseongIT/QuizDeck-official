# Nginx config for QuizDeck (React + Laravel)
# Save to /etc/nginx/sites-available/quizdeck and symlink into sites-enabled

server {
    listen 80;
    listen [::]:80;
    server_name your-domain.com;

    # Increase body size for image/media uploads
    client_max_body_size 20m;

    # Root serves the React build (created by `npm run build` in frontend)
    root /var/www/quizdeck/frontend/build;
    index index.html;

    # Gzip for text assets
    gzip on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;

    # Redirect well-known ACME for certbot (optional)
    location ^~ /.well-known/acme-challenge/ { allow all; root /var/www/quizdeck/.well-known/acme-challenge/; }

    # API proxy to Laravel running under PHP-FPM with public path
    location ^~ /api/ {
        # Serve public storage via Laravel route /api/storage/* if used
        try_files $uri @laravel;
    }

    location @laravel {
        # Forward to php-fpm via index.php front controller
        root /var/www/quizdeck/backend/public;
        rewrite ^/api/(.*)$ /index.php?/$1 last;
    }

    # PHP handling for Laravel (only for backend/public)
    location ~ \.php$ {
        root /var/www/quizdeck/backend/public;
        include snippets/fastcgi-php.conf;
        fastcgi_pass unix:/var/run/php/php8.2-fpm.sock; # adjust PHP version if needed
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        include fastcgi_params;
    }

    # Static assets for React and fallback to index.html for SPA routing
    location / {
        try_files $uri /index.html;
    }

    # Security headers (basic hardening)
    add_header X-Content-Type-Options nosniff;
    add_header X-Frame-Options SAMEORIGIN;
    add_header Referrer-Policy no-referrer-when-downgrade;
}
